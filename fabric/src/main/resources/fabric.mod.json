{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "All-Rights-Reserved",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["org.deymosko.lootroll.fabric.LootrollFabric"],
    "client": ["org.deymosko.lootroll.fabric.LootrollFabricClient"]
  },
  "mixins": ["lootroll-fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": ">=${architectury_api_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  }
}
